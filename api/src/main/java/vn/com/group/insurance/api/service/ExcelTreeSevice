import org.apache.poi.ss.usermodel.*;
import org.springframework.web.multipart.MultipartFile;
import java.io.InputStream;
import java.util.*;

public Map<String, List<String>> readExcelToMapByRowName(MultipartFile file) throws Exception {
    // Dùng LinkedHashMap để giữ nguyên thứ tự dòng từ trên xuống dưới
    Map<String, List<String>> resultMap = new LinkedHashMap<>(); 
    DataFormatter formatter = new DataFormatter();

    try (InputStream is = file.getInputStream();
         Workbook workbook = WorkbookFactory.create(is)) {
        
        Sheet sheet = workbook.getSheetAt(0);
        
        for (Row row : sheet) {
            if (row == null) continue;

            // Đọc ô đầu tiên (Cột 0) làm Key
            Cell headerCell = row.getCell(0, Row.MissingCellPolicy.RETURN_BLANK_AS_NULL);
            if (headerCell == null) continue; // Bỏ qua dòng trống không có header
            
            String rowName = formatter.formatCellValue(headerCell).trim();
            List<String> rowDataList = new ArrayList<>();
            
            // row.getLastCellNum() trả về index của cột cuối cùng có dữ liệu + 1
            int lastCellNum = row.getLastCellNum(); 
            
            // Bắt đầu đọc từ cột 1 (Bỏ qua cột 0 vì nó đã làm Key)
            for (int colIndex = 1; colIndex < lastCellNum; colIndex++) {
                Cell dataCell = row.getCell(colIndex, Row.MissingCellPolicy.RETURN_BLANK_AS_NULL);
                String cellValue = formatter.formatCellValue(dataCell).trim();
                
                // Nếu muốn bỏ qua các ô trống xen kẽ, có thể thêm: if (!cellValue.isEmpty())
                rowDataList.add(cellValue);
            }
            
            resultMap.put(rowName, rowDataList);
        }
    }
    return resultMap;
}
