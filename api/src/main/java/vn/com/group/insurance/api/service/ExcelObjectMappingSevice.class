package com.example.excelapi.service;

import com.example.excelapi.annotation.*;
import org.apache.poi.ss.usermodel.*;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import java.lang.reflect.Field;
import java.math.BigDecimal;
import java.util.*;

@Service
public class ExcelObjectMappingService {

    public PolicyDto parseExcelByAnnotations(MultipartFile file, int packageHeaderRowIndex) throws Exception {
        PolicyDto policy = new PolicyDto();

        try (Workbook workbook = WorkbookFactory.create(file.getInputStream())) {
            Sheet sheet = workbook.getSheetAt(0);

            // 1. Quét phần Header (Policy Properties)
            for (int i = 0; i < packageHeaderRowIndex; i++) {
                Row row = sheet.getRow(i);
                if (row == null) continue;
                String label = getCellValueAsString(row.getCell(0));
                Object value = parseDynamicValue(getCellValueAsString(row.getCell(1)));
                if (!label.isEmpty()) mapToProperty(Map.of(0, policy), label, value);
            }

            // 2. Quét mảng Package (Dọc theo Cột)
            Row pkgHeaderRow = sheet.getRow(packageHeaderRowIndex);
            if (pkgHeaderRow == null) return policy;

            for (int col = 1; col < pkgHeaderRow.getLastCellNum(); col++) {
                String pkgName = getCellValueAsString(pkgHeaderRow.getCell(col)).trim();
                if (pkgName.isEmpty()) continue;

                PackageDto pkg = new PackageDto();
                pkg.setPackageName(pkgName);

                // Quản lý các Node đang kích hoạt theo Độ Sâu (Level do Lập trình viên quy định)
                Map<Integer, Object> activeNodes = new HashMap<>();
                activeNodes.put(0, policy);
                activeNodes.put(1, pkg);

                for (int rowIdx = packageHeaderRowIndex + 1; rowIdx <= sheet.getLastRowNum(); rowIdx++) {
                    Row row = sheet.getRow(rowIdx);
                    if (row == null) continue;

                    String rawLabel = getCellValueAsString(row.getCell(0)).trim();
                    if (rawLabel.isEmpty() || rawLabel.equalsIgnoreCase("NaN")) continue;

                    // Chỉ lấy phần tử cuối sau dấu "_" để tránh bị trùng lặp từ khóa ("Gói SP 1_Tính tiền" -> "Tính tiền")
                    String shortLabel = getShortName(rawLabel);
                    Object value = parseDynamicValue(getCellValueAsString(row.getCell(col)));

                    // BƯỚC 1: Ưu tiên map vào các Thuộc tính đơn (Properties) trước
                    boolean isHandled = mapToProperty(activeNodes, shortLabel, value);

                    // BƯỚC 2: Nếu không phải Property, kiểm tra xem nó có kích hoạt một Node mới không (Collections)
                    if (!isHandled) {
                        createNodeToCollection(activeNodes, shortLabel, value);
                    }
                }
                policy.getPackages().add(pkg);
            }
        }
        return policy;
    }

    // ==========================================
    // CÁC HÀM XỬ LÝ REFLECTION & ANNOTATION
    // ==========================================

    private boolean mapToProperty(Map<Integer, Object> activeNodes, String label, Object value) throws Exception {
        String lowerLabel = label.toLowerCase();
        
        for (Map.Entry<Integer, Object> entry : activeNodes.entrySet()) {
            Object obj = entry.getValue();
            if (obj == null) continue;

            for (Field field : obj.getClass().getDeclaredFields()) {
                ExcelProperty ann = field.getAnnotation(ExcelProperty.class);
                if (ann != null && ann.level() == entry.getKey()) {
                    for (String kw : ann.keyword()) {
                        if (lowerLabel.contains(kw.toLowerCase())) {
                            field.setAccessible(true);
                            field.set(obj, castValue(field.getType(), value));
                            return true; // Match thành công
                        }
                    }
                }
            }
        }
        return false;
    }

    private boolean createNodeToCollection(Map<Integer, Object> activeNodes, String label, Object value) throws Exception {
        String lowerLabel = label.toLowerCase();
        
        for (Map.Entry<Integer, Object> entry : activeNodes.entrySet()) {
            Object parentObj = entry.getValue();
            if (parentObj == null) continue;

            for (Field field : parentObj.getClass().getDeclaredFields()) {
                ExcelCollection ann = field.getAnnotation(ExcelCollection.class);
                // Tìm kiếm Collection phù hợp ở ngay cấp độ tiếp theo
                if (ann != null && ann.level() == entry.getKey() + 1) {
                    for (String kw : ann.keyword()) {
                        if (lowerLabel.contains(kw.toLowerCase())) {
                            
                            // 1. Tạo Object mới (Ví dụ: ProductDto)
                            Object newNode = ann.itemClass().getDeclaredConstructor().newInstance();
                            
                            // 2. Tự động tiêm Label và Value vào Node mới
                            injectNodeNameAndValue(newNode, label, value);
                            
                            // 3. Thêm vào List của Node Cha
                            field.setAccessible(true);
                            @SuppressWarnings("unchecked")
                            List<Object> list = (List<Object>) field.get(parentObj);
                            if (list == null) {
                                list = new ArrayList<>();
                                field.set(parentObj, list);
                            }
                            list.add(newNode);
                            
                            // 4. Cập nhật Map Active Nodes & Xóa vết các level sâu hơn
                            activeNodes.put(ann.level(), newNode);
                            activeNodes.keySet().removeIf(k -> k > ann.level());
                            
                            return true;
                        }
                    }
                }
            }
        }
        return false;
    }

    private void injectNodeNameAndValue(Object node, String name, Object value) throws Exception {
        for (Field field : node.getClass().getDeclaredFields()) {
            if (field.isAnnotationPresent(ExcelNodeName.class)) {
                field.setAccessible(true);
                field.set(node, name);
            }
            if (field.isAnnotationPresent(ExcelNodeValue.class)) {
                field.setAccessible(true);
                field.set(node, castValue(field.getType(), value));
            }
        }
    }

    // ==========================================
    // CÁC HÀM TIỆN ÍCH DỮ LIỆU
    // ==========================================

    private String getShortName(String fullLabel) {
        String[] parts = fullLabel.split("_");
        return parts[parts.length - 1].trim();
    }

    private Object castValue(Class<?> type, Object value) {
        if (value == null) return null;
        String s = value.toString().trim();
        
        if (type == Boolean.class || type == boolean.class) {
            String up = s.toUpperCase();
            return up.equals("1") || up.equals("TRUE") || up.equals("YES");
        } else if (type == Long.class || type == long.class) {
            return new BigDecimal(s).longValue();
        } else if (type == Integer.class || type == int.class) {
            return new BigDecimal(s).intValue();
        }
        return s;
    }

    private Object parseDynamicValue(String value) {
        if (value == null || value.isEmpty()) return null;
        try {
            BigDecimal bd = new BigDecimal(value).stripTrailingZeros();
            return bd.scale() <= 0 ? bd.longValueExact() : bd.doubleValue();
        } catch (Exception e) { return value; }
    }

    private String getCellValueAsString(Cell cell) {
        if (cell == null) return "";
        switch (cell.getCellType()) {
            case STRING: return cell.getStringCellValue();
            case NUMERIC: return BigDecimal.valueOf(cell.getNumericCellValue()).stripTrailingZeros().toPlainString();
            case BOOLEAN: return String.valueOf(cell.getBooleanCellValue());
            default: return "";
        }
    }

private Object castValue(Class<?> targetType, Object value) {
    if (value == null) return null;

    String s = value.toString().trim();
    if (s.isEmpty()) return null;

    // 1. Xử lý nhóm Boolean (hỗ trợ 1/0, True/False, Yes/No)
    if (targetType == Boolean.class || targetType == boolean.class) {
        String up = s.toUpperCase();
        return up.equals("1") || up.equals("TRUE") || up.equals("YES") || up.equals("Y");
    }

    // 2. Xử lý nhóm Số học (Sử dụng BigDecimal làm trung gian để chống sai số/thập phân dư)
    try {
        if (targetType == Long.class || targetType == long.class) {
            return new BigDecimal(s).longValue();
        } else if (targetType == Integer.class || targetType == int.class) {
            return new BigDecimal(s).intValue();
        } else if (targetType == Double.class || targetType == double.class) {
            return new BigDecimal(s).doubleValue();
        } else if (targetType == Float.class || targetType == float.class) {
            return new BigDecimal(s).floatValue();
        } else if (targetType == BigDecimal.class) {
            return new BigDecimal(s);
        }
    } catch (Exception e) {
        System.err.println("Cảnh báo: Không thể ép giá trị '" + s + "' sang kiểu " + targetType.getSimpleName());
        return null;
    }

    // 3. Xử lý nhóm String
    if (targetType == String.class) {
        // Nếu giá trị nguyên gốc là một số lớn bị Excel biến thành E (1.2E8)
        // Ta đưa nó về số tự nhiên trước khi trả ra String ("120000000")
        try {
            return new BigDecimal(s).stripTrailingZeros().toPlainString();
        } catch (Exception e) {
            return s; // Nếu là chuỗi chữ bình thường ("Khách hàng VIP") thì giữ nguyên
        }
    }

    // 4. Nếu là các Object tĩnh khác, trả về nguyên bản
    return value;
}

}
